# Banco de dados local
DB_URL=jdbc:postgresql://localhost:5432/axegestor
DB_USERNAME=postgres
DB_PASSWORD=troque-aqui

# JWT
# Use um segredo longo e unico em producao. Nao use este valor de exemplo.
JWT_SECRET=troque-por-um-segredo-grande-com-pelo-menos-32-caracteres
JWT_EXPIRATION_HOURS=8

# Frontend permitido pelo CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Primeiro administrador
# Usado somente quando a tabela usuarios ainda esta vazia.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@axegestor.local
ADMIN_PASSWORD=troque-esta-senha
